# TP-Link Tapo Cloud Account Credentials
TAPO_USERNAME=your_tapo_email@example.com
TAPO_PASSWORD=your_tapo_password

# Comma-separated LAN IP addresses of your Tapo L530 Smart Bulbs per room
# Add any room using TAPO_IPS_<ROOM_NAME>=ip1,ip2
TAPO_IPS_BEDROOM=192.168.1.100,192.168.1.101
# TAPO_IPS_OFFICE=192.168.1.102,192.168.1.103
